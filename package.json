{
  "name": "atende-ai",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ]
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @atende/db generate",
    "db:migrate": "pnpm --filter @atende/db migrate"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.2",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.9.0"
  }
}
