{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atende-ai-web",
  // Entry customizado: embrulha .open-next/worker.js e adiciona `scheduled`
  // (GCal pull). O cf:build continua gerando o worker do OpenNext normalmente.
  "main": "worker.ts",
  // Cron do GCal pull — a cada 10 min (critério doc 04 §2.3: eco ≤ 15 min)
  "triggers": { "crons": ["*/10 * * * *"] },
  // URL pública do app (redirect_uri do OAuth Google). Não é segredo.
  //
  // AGENDA_HABILITADA: a agenda é módulo congelado e saiu da superfície do
  // produto — o comprador passou a ser distribuidor com entrega, para quem
  // "Profissionais" e "Salas & bloqueios" dizem que o produto não é para ele.
  // Desligada fecha o menu E as rotas, inclusive a booking pública. Vira coluna
  // por empresa quando existir um tenant que precise da diferença
  // (`src/lib/flags.ts`).
  "vars": {
    "APP_BASE_URL": "https://atende-ai-web.atende-ai.workers.dev",
    "AGENDA_HABILITADA": "false",
    // CADASTRO_ABERTO: enquanto não existir cobrança — não há plano,
    // assinatura, limite nem porta de pagamento em produto nenhum —, cadastro
    // aberto atrai de graça o público que o perfil de cliente manda recusar.
    // Conta nova nasce por convite. Reabrir quando a cobrança existir.
    "CADASTRO_ABERTO": "false"
  },
  "account_id": "c158973636514615cb24b9ff908147b1",
  // nodejs_compat: habilita node:async_hooks (AsyncLocalStorage da tenancy),
  // node:crypto (AES/argon salt) e o driver pg sobre TCP. Data >= 2025-04-01
  // melhora o preenchimento de process.env no runtime (secrets/vars).
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Cache incremental do OpenNext (ISR/data cache). KV reutiliza o namespace
  // que também guardará config de tenant por slug (doc 09).
  "kv_namespaces": [
    { "binding": "CONFIG_KV", "id": "e1860ad085fe4e21ab85e1fa8c84530f" }
  ]
  // R2 NÃO precisa de binding aqui, e isto foi uma descoberta, não uma escolha:
  // o R2 tem endpoint S3, e `packages/armazenamento` é um driver S3 escrito com
  // `fetch` e assinatura SigV4 à mão — que roda igual no Node do worker e no
  // workerd do painel. A mídia passou a depender de credencial em secret
  // (S3_ENDPOINT, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_BUCKET), não de
  // permissão de binding no token. Local, as mesmas variáveis apontam para o
  // MinIO do compose.
  //
  // S3_BASE_LEITURA fica DESLIGADA de propósito: com ela, a mídia vira link
  // público sem sessão, e conversa é dado pessoal de terceiro. A leitura sai
  // por `/api/midia/[...chave]`, que confere o tenant a cada requisição.
  //
  // Secrets (DATABASE_URL, SESSION_SECRET, ENCRYPTION_KEY, APP_BASE_URL) NÃO
  // ficam aqui — são injetados via `wrangler secret` / CI (nunca no repo).
}
