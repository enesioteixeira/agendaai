{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@atende/core": [
        "packages/core/src"
      ],
      "@atende/core/*": [
        "packages/core/src/*"
      ],
      "@atende/db": [
        "packages/db/src"
      ],
      "@atende/db/*": [
        "packages/db/src/*"
      ],
      "@atende/canais": [
        "packages/canais/src"
      ],
      "@atende/canais/*": [
        "packages/canais/src/*"
      ],
      "@atende/ui": [
        "packages/ui/src"
      ],
      "@atende/ui/*": [
        "packages/ui/src/*"
      ],
      "@atende/dinheiro": [
        "packages/dinheiro/src"
      ],
      "@atende/dinheiro/*": [
        "packages/dinheiro/src/*"
      ],
      "@atende/ia": [
        "packages/ia/src"
      ],
      "@atende/ia/*": [
        "packages/ia/src/*"
      ],
      "@atende/integracoes": [
        "packages/integracoes/src"
      ],
      "@atende/integracoes/*": [
        "packages/integracoes/src/*"
      ]
    }
  }
}
