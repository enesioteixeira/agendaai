// atende-ai — schema Prisma
// Fonte de verdade do desenho: docs/02-modelo-de-dados.md
// Convenções (doc 02 §1): ids cuid; empresaId em toda tabela de tenant;
// unicidade composta @@unique([empresaId, ...]) (exceções: Usuario.email e models de plataforma);
// centavos Int; timestamps UTC; soft-delete deletedAt em dados de titular.
// prisma migrate SEMPRE — db push é banido (regra inviolável 13).

// queryCompiler + driverAdapters (preview): client SEM engine Rust — o plano
// de query é compilado em WASM embutido no próprio client. É o único modo que
// funciona em Cloudflare Workers com conexão direta ao Postgres (o engine
// nativo tenta fs.readdir/getCurrentBinaryTarget no workerd e quebra) e o
// MESMO client roda em Node (testes/CI/worker) via @prisma/adapter-pg.
// SEM `output`: o client fica em node_modules/.prisma/client (resolução padrão).
generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Domínio identidade (doc 02 §2) — Bloco 1 do MVP
// Usuario é GLOBAL (email único no sistema); a pertença a um tenant
// é o VinculoUsuarioEmpresa, que materializa o payload JWT
// {usuarioId, empresaId, unidadeId, papelId, escopos[]}.
// ─────────────────────────────────────────────────────────────

// A vertical do tenant. Os valores mudaram junto com o perfil de cliente: o
// comprador é distribuidor com entrega, e o enum anterior (salao, barbearia,
// clinica_estetica, clinica_medica, advocacia) era, valor por valor, a lista de
// segmentos que o posicionamento manda recusar — um distribuidor só cabia como
// "outro". O produto precisa saber nomear o próprio cliente-alvo.
enum VerticalEmpresa {
  distribuidor_alimentos
  distribuidor_geral
  outro
}

// No atacado o contato é uma empresa: tem CNPJ, comprador, condição comercial e
// vendedor responsável. O modelo nasceu pessoa física com CPF, que é a forma
// certa para o público antigo e a errada para este.
enum TipoPessoa {
  fisica
  juridica
}

enum StatusConvite {
  pendente
  aceito
  expirado
  revogado
}

model Empresa {
  id       String          @id @default(cuid())
  slug     String          @unique // ÚNICO GLOBAL — resolve a booking page {slug}.atende-ai.com.br
  nome     String
  cnpj     String?
  vertical VerticalEmpresa
  // FK lógica para PlanoLicenca (doc 02 §10) — a relation entra com o domínio plataforma no Bloco 1
  planoId  String?
  ativa    Boolean         @default(true)
  criadaEm DateTime        @default(now())

  unidades Unidade[]
  vinculos VinculoUsuarioEmpresa[]
  papeis   Papel[]
  apiKeys  ApiKey[]
  convites ConviteUsuario[]

  // Bloco 2 — agenda + clientes
  clientes           Cliente[]
  profissionais      Profissional[]
  servicos           Servico[]
  recursos           Recurso[]
  horariosTrabalho   HorarioTrabalho[]
  bloqueios          Bloqueio[]
  agendamentos       Agendamento[]
  sincronizacoesGcal SincronizacaoGcal[]

  // Bloco 3 — atendimento + clientes completo
  identidadesCanal  IdentidadeCanal[]
  notasCliente      NotaCliente[]
  tags              Tag[]
  tagsCliente       TagCliente[]
  canais            Canal[]
  conversas         Conversa[]
  mensagens         Mensagem[]
  authStatesBaileys AuthStateBaileys[]

  // Fase C — motor de IA
  propostas       PropostaAcao[]
  resumosConversa ResumoConversa[]
  feedbacksIA     FeedbackIA[]

  // Fase D — agentes por tenant · Fase G — integrações de retaguarda
  agentesIA           AgenteIA[]
  versoesAgente       VersaoAgente[]
  integracoes         IntegracaoExterna[]
  mapeamentos         MapeamentoEntidade[]
  // Operação de atendimento e plataforma (E1)
  filas               Fila[]
  motivosEncerramento MotivoEncerramento[]
  etiquetas           EtiquetaConversa[]
  respostasRapidas    RespostaRapida[]
  assinaturas         AssinaturaPlataforma[]
  usoMensal           UsoMensal[]
  usoIA               UsoIA[]
}

model Unidade {
  id                    String  @id @default(cuid())
  empresaId             String
  nome                  String
  fusoHorario           String  @default("America/Sao_Paulo") // IANA
  endereco              Json?
  horariosFuncionamento Json? // por dia da semana
  ativa                 Boolean @default(true)

  empresa Empresa @relation(fields: [empresaId], references: [id])

  // Bloco 2 — agenda
  profissionais    Profissional[]
  recursos         Recurso[]
  horariosTrabalho HorarioTrabalho[]
  bloqueios        Bloqueio[]
  agendamentos     Agendamento[]

  // Bloco 3 — canais ancorados na unidade (opcional)
  canais Canal[]

  @@unique([empresaId, nome])
  @@index([empresaId])
}

model Usuario {
  id        String    @id @default(cuid())
  email     String    @unique // ÚNICO GLOBAL — exceção explícita à convenção de tenancy (doc 02 §2)
  senhaHash String // argon2id
  nome      String
  telefone  String?
  deletedAt DateTime? // soft-delete (regra inviolável 9)

  vinculos      VinculoUsuarioEmpresa[]
  profissionais Profissional[] // opcional — nem todo profissional loga (doc 02 §3)

  // Bloco 3 — atendimento
  notasAutoradas     NotaCliente[]
  conversasAtendidas Conversa[]
  mensagensAutoradas Mensagem[]
  carteira           Cliente[]      @relation("CarteiraDoVendedor")
  filas              MembroFila[]
  notasDeConversa    NotaConversa[] @relation("NotasDeConversa")
}

model VinculoUsuarioEmpresa {
  id                 String  @id @default(cuid())
  empresaId          String
  usuarioId          String
  papelId            String
  unidadesPermitidas Json    @default("[]") // lista de unidadeId — vazia = todas (decisão doc 02 §2)
  ativo              Boolean @default(true)

  empresa Empresa @relation(fields: [empresaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])
  papel   Papel   @relation(fields: [papelId], references: [id])

  @@unique([empresaId, usuarioId]) // um papel por usuário por tenant; troca de papel é update auditado
  @@index([empresaId])
  @@index([usuarioId])
}

model Papel {
  id        String  @id @default(cuid())
  empresaId String
  nome      String
  sistema   Boolean @default(false) // criado no onboarding (doc 02 §12) — editável, recriável

  empresa  Empresa                 @relation(fields: [empresaId], references: [id])
  escopos  PapelEscopo[]
  vinculos VinculoUsuarioEmpresa[]
  convites ConviteUsuario[]

  @@unique([empresaId, nome])
  @@index([empresaId])
}

// Catálogo GLOBAL de plataforma (sem empresaId): o produto define os
// escopos, o tenant compõe papéis (decisão doc 02 §2).
model Escopo {
  chave     String @id // ex.: "agenda:criar", "contratos:enviar"
  modulo    String
  descricao String

  papeis PapelEscopo[]
}

model PapelEscopo {
  id          String @id @default(cuid())
  empresaId   String
  papelId     String
  escopoChave String

  papel  Papel  @relation(fields: [papelId], references: [id])
  escopo Escopo @relation(fields: [escopoChave], references: [chave])

  @@unique([empresaId, papelId, escopoChave])
  @@index([empresaId])
}

model ApiKey {
  id           String    @id @default(cuid())
  empresaId    String
  nome         String
  hashChave    String // sha-256 do segredo; chave emitida: ak_live_<id>_<segredo> (decisão doc 02 §2)
  escopos      Json      @default("[]") // subconjunto dos escopos do tenant
  rateLimitRpm Int // teto vem do PlanoLicenca; tenant só configura MENOR; estouro = HTTP 429 + Retry-After
  ultimoUsoEm  DateTime?
  expiraEm     DateTime?
  ativa        Boolean   @default(true)

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@index([empresaId])
}

model ConviteUsuario {
  id                 String        @id @default(cuid())
  empresaId          String
  email              String
  papelId            String
  unidadesPermitidas Json          @default("[]")
  tokenHash          String
  status             StatusConvite @default(pendente)
  expiraEm           DateTime

  empresa Empresa @relation(fields: [empresaId], references: [id])
  papel   Papel   @relation(fields: [papelId], references: [id])

  // Unicidade parcial (status pendente) vai em migration SQL manual — reenvio revoga o anterior (doc 02 §2)
  @@index([empresaId, email])
}

// ─────────────────────────────────────────────────────────────
// Domínio clientes (doc 02 §4) — mínimo do Bloco 2: o Agendamento
// referencia Cliente. IdentidadeCanal/Nota/Tag chegam no Bloco 3
// (pivô do omnichannel).
// ─────────────────────────────────────────────────────────────

model Cliente {
  id             String     @id @default(cuid())
  empresaId      String
  nome           String
  telefone       String? // E.164
  email          String?
  cpf            String?
  // Identidade de pessoa jurídica — o caso normal no atacado.
  tipoPessoa     TipoPessoa @default(juridica)
  cnpj           String?
  razaoSocial    String?
  // Carteira: quem responde comercialmente por este cliente. Sem isto não há
  // como distribuir conversa por carteira do vendedor, que é requisito de MVP
  // do atendimento (P1-ATD-003).
  vendedorId     String?
  dataNascimento DateTime?
  endereco       Json?
  observacoes    String?
  provisorio     Boolean    @default(false) // criado por inbound/booking sem cadastro completo
  deletedAt      DateTime? // soft-delete LGPD (regra inviolável 9)

  empresa      Empresa       @relation(fields: [empresaId], references: [id])
  vendedor     Usuario?      @relation("CarteiraDoVendedor", fields: [vendedorId], references: [id])
  agendamentos Agendamento[]

  // Bloco 3 — omnichannel
  identidades IdentidadeCanal[]
  notas       NotaCliente[]
  tags        TagCliente[]
  conversas   Conversa[]

  // Postgres não iguala NULLs em unique — clientes sem CPF coexistem (doc 02 §4).
  // Mesma lógica vale para o CNPJ.
  @@unique([empresaId, cpf])
  @@unique([empresaId, cnpj])
  // Índice de busca do painel (empresaId, nome) é PARCIAL (deletedAt IS NULL,
  // doc 02 §14.1) — vive em migration SQL manual.
  @@index([empresaId])
}

// ─────────────────────────────────────────────────────────────
// Domínio agenda (doc 02 §3) — Bloco 2 do MVP
// Regra de ouro: disponibilidade é calculada no banco; a escrita
// concorrente é arbitrada pela EXCLUSION CONSTRAINT (§3.1, migration
// SQL manual) — cache nunca é juiz de horário.
// ─────────────────────────────────────────────────────────────

enum StatusAgendamento {
  agendado
  confirmado
  em_atendimento
  concluido
  cancelado
  nao_compareceu
}

enum OrigemAgendamento {
  painel
  booking
  ia
  arvore
}

enum TipoRecurso {
  sala
  cadeira
  equipamento
}

enum TipoBloqueio {
  ferias
  almoco
  manutencao
  outro
}

enum EstadoSyncGcal {
  desconectado
  ativo
  erro_token
  pausado
}

// Entidade própria, OPCIONALMENTE ligada a Usuario: o manicure que não
// acessa o painel existe na agenda mesmo sem login (doc 02 §3).
model Profissional {
  id        String    @id @default(cuid())
  empresaId String
  unidadeId String
  usuarioId String? // nem todo profissional loga
  nome      String
  cor       String? // cor na grade da agenda
  ativo     Boolean   @default(true)
  deletedAt DateTime? // soft-delete (dado de titular — regra inviolável 9)

  empresa       Empresa            @relation(fields: [empresaId], references: [id])
  unidade       Unidade            @relation(fields: [unidadeId], references: [id])
  usuario       Usuario?           @relation(fields: [usuarioId], references: [id])
  horarios      HorarioTrabalho[]
  bloqueios     Bloqueio[]
  agendamentos  Agendamento[]
  sincronizacao SincronizacaoGcal?

  @@index([empresaId, unidadeId])
}

model Servico {
  id                String  @id @default(cuid())
  empresaId         String
  nome              String
  duracaoMin        Int
  precoCentavos     Int // centavos SEMPRE (regra inviolável 16)
  exigeContrato     Boolean @default(false)
  exigeSinal        Boolean @default(false)
  percentualSinalBp Int? // basis points (10000 = 100%)
  visivelNaBooking  Boolean @default(true)
  ativo             Boolean @default(true)

  empresa      Empresa       @relation(fields: [empresaId], references: [id])
  agendamentos Agendamento[]

  @@unique([empresaId, nome])
}

model Recurso {
  id         String      @id @default(cuid())
  empresaId  String
  unidadeId  String
  nome       String
  tipo       TipoRecurso
  capacidade Int         @default(1) // MVP trata como 1 na constraint (decisão doc 02 §3.1)
  ativo      Boolean     @default(true)

  empresa      Empresa       @relation(fields: [empresaId], references: [id])
  unidade      Unidade       @relation(fields: [unidadeId], references: [id])
  bloqueios    Bloqueio[]
  agendamentos Agendamento[]

  @@unique([empresaId, unidadeId, nome])
}

model HorarioTrabalho {
  id             String @id @default(cuid())
  empresaId      String
  profissionalId String
  unidadeId      String
  diaSemana      Int // 0 (domingo) – 6 (sábado)
  horaInicio     String // "HH:mm" no fuso da Unidade
  horaFim        String

  empresa      Empresa      @relation(fields: [empresaId], references: [id])
  profissional Profissional @relation(fields: [profissionalId], references: [id])
  unidade      Unidade      @relation(fields: [unidadeId], references: [id])

  // Permite grade quebrada (manhã + tarde) — doc 02 §3
  @@unique([empresaId, profissionalId, unidadeId, diaSemana, horaInicio])
}

// Exatamente UM alvo entre profissional/recurso/unidade — validado em código
// (packages/core), não em constraint (doc 02 §3). Bloqueio filtra a LISTAGEM
// de slots; a corrida residual é resolvida por revalidação transacional na
// escrita do agendamento (doc 02 §3.1).
model Bloqueio {
  id             String       @id @default(cuid())
  empresaId      String
  tipo           TipoBloqueio
  profissionalId String?
  recursoId      String?
  unidadeId      String?
  inicio         DateTime     @db.Timestamptz(3)
  fim            DateTime     @db.Timestamptz(3)
  motivo         String?
  // Cache do Google Calendar pull (doc 02 §3.1): bloqueios espelhando janelas
  // ocupadas do GCal do profissional. O cron substitui TODOS os origemGcal do
  // profissional a cada sync (replace-all idempotente) — nunca editar à mão.
  origemGcal     Boolean      @default(false)

  empresa      Empresa       @relation(fields: [empresaId], references: [id])
  profissional Profissional? @relation(fields: [profissionalId], references: [id])
  recurso      Recurso?      @relation(fields: [recursoId], references: [id])
  unidade      Unidade?      @relation(fields: [unidadeId], references: [id])

  @@index([empresaId, inicio])
}

model Agendamento {
  id                 String            @id @default(cuid())
  empresaId          String
  unidadeId          String
  clienteId          String
  profissionalId     String
  servicoId          String
  recursoId          String?
  // Timestamptz: a exclusion constraint usa tstzrange(inicio, fim) (doc 02 §3.1)
  inicio             DateTime          @db.Timestamptz(3)
  fim                DateTime          @db.Timestamptz(3)
  status             StatusAgendamento @default(agendado)
  origem             OrigemAgendamento
  observacoes        String?
  canceladoEm        DateTime?
  motivoCancelamento String?
  eventoGcalId       String? // evento espelho no GCal — regra anti-eco do sync (doc 02 §3.1)

  empresa      Empresa      @relation(fields: [empresaId], references: [id])
  unidade      Unidade      @relation(fields: [unidadeId], references: [id])
  cliente      Cliente      @relation(fields: [clienteId], references: [id])
  profissional Profissional @relation(fields: [profissionalId], references: [id])
  servico      Servico      @relation(fields: [servicoId], references: [id])
  recurso      Recurso?     @relation(fields: [recursoId], references: [id])

  // Exclusion constraints anti-sobreposição (profissional e recurso) vivem em
  // migration SQL manual — Prisma não expressa EXCLUDE (doc 02 §3.1).
  // Índices quentes (doc 02 §14.1):
  @@index([empresaId, unidadeId, inicio]) // grade do dia por unidade
  @@index([empresaId, profissionalId, inicio]) // agenda do profissional / slots
  @@index([empresaId, clienteId, inicio]) // histórico do cliente
}

model SincronizacaoGcal {
  id             String         @id @default(cuid())
  empresaId      String
  profissionalId String         @unique // 1:1 com Profissional (cuid já é tenant-scoped)
  tokensCifrados String // OAuth AES-256-GCM (regra inviolável 15)
  estadoSync     EstadoSyncGcal @default(desconectado)
  syncTokenGcal  String? // sync incremental do pull
  canalWatchId   String? // watch channels — preparado p/ Fase 2
  canalExpiraEm  DateTime?
  ultimaSyncEm   DateTime?

  empresa      Empresa      @relation(fields: [empresaId], references: [id])
  profissional Profissional @relation(fields: [profissionalId], references: [id])

  @@unique([empresaId, profissionalId]) // um Google Calendar por profissional
}

// ─────────────────────────────────────────────────────────────
// Domínio clientes — complemento do Bloco 3 (doc 02 §4).
// IdentidadeCanal é o pivô do omnichannel: todo inbound resolve
// (empresaId, tipo, valor) → Cliente; sem cadastro, nasce provisório.
// Merge automático SÓ por identificador verificado (decisão §4).
// ─────────────────────────────────────────────────────────────

enum TipoIdentidade {
  whatsapp
  instagram
  messenger
  telegram
  email
  webchat
}

model IdentidadeCanal {
  id           String         @id @default(cuid())
  empresaId    String
  clienteId    String
  tipo         TipoIdentidade
  valor        String // E.164 p/ telefone; id opaco nos demais
  verificada   Boolean        @default(false) // posse comprovada por OTP
  verificadaEm DateTime?
  deletedAt    DateTime?

  empresa   Empresa    @relation(fields: [empresaId], references: [id])
  cliente   Cliente    @relation(fields: [clienteId], references: [id])
  conversas Conversa[]

  // A linha-mestra do inbound: um telefone pertence a UM cliente por tenant
  @@unique([empresaId, tipo, valor])
  @@index([empresaId, clienteId])
}

model NotaCliente {
  id             String    @id @default(cuid())
  empresaId      String
  clienteId      String
  autorUsuarioId String?
  texto          String
  criadoEm       DateTime  @default(now())
  deletedAt      DateTime?

  empresa Empresa  @relation(fields: [empresaId], references: [id])
  cliente Cliente  @relation(fields: [clienteId], references: [id])
  autor   Usuario? @relation(fields: [autorUsuarioId], references: [id])

  @@index([empresaId, clienteId])
}

model Tag {
  id        String  @id @default(cuid())
  empresaId String
  nome      String
  cor       String?

  empresa Empresa      @relation(fields: [empresaId], references: [id])
  usos    TagCliente[]

  @@unique([empresaId, nome])
}

model TagCliente {
  id        String @id @default(cuid())
  empresaId String
  tagId     String
  clienteId String

  empresa Empresa @relation(fields: [empresaId], references: [id])
  tag     Tag     @relation(fields: [tagId], references: [id])
  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@unique([empresaId, tagId, clienteId])
}

// ─────────────────────────────────────────────────────────────
// Domínio atendimento — Bloco 3 (doc 02 §5, spec doc 05).
// Materializados aqui: Canal, Conversa, Mensagem, AuthStateBaileys.
// Os models de motor/IA (PropostaAcao, FluxoArvore, VersaoFluxo,
// ResumoConversa, FeedbackIA) entram no Bloco 4 — Conversa já carrega
// fluxoVersaoId/noAtualId como Strings puras até lá.
// ─────────────────────────────────────────────────────────────

enum TipoCanal {
  whatsapp_oficial
  whatsapp_baileys
  telegram
  webchat
  instagram
  messenger
  email
}

enum StatusConexaoCanal {
  desconectado
  pareando
  conectado
  erro
}

enum EstadoConversa {
  bot_arvore
  bot_ia
  fila_humano
  humano
  encerrada
}

enum DirecaoMensagem {
  entrada
  saida
}

enum TipoMensagem {
  texto
  imagem
  audio
  video
  documento
  localizacao
  interativo
}

enum OrigemMensagem {
  cliente
  arvore
  ia
  humano
  sistema
}

enum StatusEntrega {
  pendente
  // Reservada por um worker, resultado ainda desconhecido. Existe para que
  // "o atendente apertou enviar" e "a mensagem saiu" deixem de ser o mesmo
  // estado — antes disto, morrer entre o claim e o envio deixava a mensagem
  // marcada como enviada, com ✓ na tela, sem ter saído.
  enviando
  enviada
  entregue
  lida
  falhou
}

model Canal {
  id             String             @id @default(cuid())
  empresaId      String
  unidadeId      String?
  tipo           TipoCanal
  nome           String // ex.: "WhatsApp Recepção"
  configCifrada  String? // tokens/segredos AES-256-GCM (regra 15)
  statusConexao  StatusConexaoCanal @default(desconectado)
  /// Quando `statusConexao` mudou pela última vez.
  ///
  /// Existe para a tela saber a IDADE do que está mostrando. Sem isso, um QR
  /// gravado por um worker que morreu em seguida fica na tela para sempre, com
  /// aparência de válido — e "escaneei e não aconteceu nada" vira mistério.
  statusAtualizadoEm DateTime?
  fluxoPadraoId  String? // FK lógica — FluxoArvore chega no Bloco 4
  /// Agente de IA que atende as conversas novas deste canal. FK LÓGICA (mesmo
  /// padrão de `fluxoPadraoId`) para não criar ciclo Canal↔AgenteIA no Prisma.
  /// `NULL` = sem IA neste canal: é o desligado, sem coluna booleana extra.
  agentePadraoId String?
  ativo          Boolean            @default(true)
  criadoEm       DateTime           @default(now())

  empresa    Empresa            @relation(fields: [empresaId], references: [id])
  unidade    Unidade?           @relation(fields: [unidadeId], references: [id])
  conversas  Conversa[]
  mensagens  Mensagem[]
  authStates AuthStateBaileys[]

  @@unique([empresaId, nome])
  @@index([empresaId])
}

model Conversa {
  id                 String         @id @default(cuid())
  empresaId          String
  canalId            String
  clienteId          String
  identidadeCanalId  String
  estado             EstadoConversa
  atendenteUsuarioId String? // dono atual quando estado=humano
  fluxoVersaoId      String? // FK lógica — versão congelada (Bloco 4)
  /// FK lógica para VersaoAgente — a versão de IA em que esta conversa começou.
  /// "Publicar é congelar" (comentário do AgenteIA) só é verdade porque isto
  /// existe: sem a coluna, o contexto resolvia a versão ativa a cada turno e
  /// publicar trocava a persona no meio da conversa.
  agenteVersaoId     String?
  noAtualId          String? // posição na árvore (Bloco 4)
  variaveis          Json? // coletadas pela árvore (Bloco 4)
  contextoJson       Json? // resumo vivo p/ a IA (Bloco 4)
  criadoEm           DateTime       @default(now())
  atualizadoEm       DateTime       @updatedAt
  encerradaEm        DateTime?
  deletedAt          DateTime?

  // Operação de atendimento (E1)
  filaId                  String?
  motivoEncerramentoId    String?
  /// Quando a primeira resposta humana ou de IA saiu. Nulo = ninguém respondeu
  /// ainda, e é essa a conversa que o painel precisa mostrar primeiro.
  primeiraRespostaEm      DateTime?
  /// Prazo calculado na entrada, a partir da fila. Guardado e não derivado:
  /// mudar o prazo da fila não pode reescrever o compromisso de conversas que
  /// já estavam em andamento.
  prazoPrimeiraRespostaEm DateTime?

  empresa            Empresa             @relation(fields: [empresaId], references: [id])
  canal              Canal               @relation(fields: [canalId], references: [id])
  cliente            Cliente             @relation(fields: [clienteId], references: [id])
  identidade         IdentidadeCanal     @relation(fields: [identidadeCanalId], references: [id])
  atendente          Usuario?            @relation(fields: [atendenteUsuarioId], references: [id])
  mensagens          Mensagem[]
  propostas          PropostaAcao[]
  resumos            ResumoConversa[]
  fila               Fila?               @relation(fields: [filaId], references: [id], onDelete: SetNull)
  motivoEncerramento MotivoEncerramento? @relation(fields: [motivoEncerramentoId], references: [id], onDelete: SetNull)
  etiquetas          ConversaEtiqueta[]
  notasInternas      NotaConversa[]

  // Fila de atendimento e inbox por estado (doc 02 §14.1)
  @@index([empresaId, estado, atualizadoEm])
  // O painel de prazo pergunta "quem está para estourar": conversa sem primeira
  // resposta, ordenada pelo prazo. Sem este índice é varredura da inbox toda.
  @@index([empresaId, prazoPrimeiraRespostaEm])
  @@index([empresaId, filaId, estado])
}

/// Propose-confirm (regra inviolável 10): NENHUMA escrita disparada por IA
/// acontece direto. A tool cria uma proposta PENDENTE, o cliente confirma pelo
/// canal, e a execução é determinística — sem LLM, com auditoria.
model PropostaAcao {
  id                String         @id @default(cuid())
  empresaId         String
  conversaId        String
  /// Só a MESMA identidade que originou confirma. Sem isto, um "sim" vindo de
  /// outro canal do mesmo cliente executaria uma proposta que ele não viu.
  identidadeCanalId String
  tipo              TipoProposta
  /// Payload congelado no momento da proposta e validado por Zod na execução.
  /// O que o modelo escrever DEPOIS não entra aqui — é o que impede que texto
  /// injetado na conversa mude o que vai ser executado.
  payload           Json
  status            StatusProposta @default(PENDENTE)
  /// TTL de 15 min: proposta velha confirmada por um "sim" tardio é a forma
  /// mais fácil de executar algo que o cliente já esqueceu que pediu.
  expiraEm          DateTime
  criadoEm          DateTime       @default(now())
  executadaEm       DateTime?
  resultadoJson     Json?
  /// Mensagem que apresentou a proposta — para reconstruir o que o cliente viu.
  mensagemId        String?

  empresa  Empresa  @relation(fields: [empresaId], references: [id])
  conversa Conversa @relation(fields: [conversaId], references: [id])

  /// Uma proposta PENDENTE por conversa (doc 05 §4): sem isto, um "sim" solto
  /// fica ambíguo entre duas propostas abertas — e a escolha errada executa a
  /// que o cliente não quis. Índice parcial em SQL manual (o Prisma não expressa
  /// `WHERE status = 'PENDENTE'`).
  @@index([empresaId, conversaId, status])
  @@index([status, expiraEm])
}

/// Resumo gerado por IA no handoff e no encerramento. Existe para o atendente
/// humano não precisar ler cinquenta mensagens antes de assumir.
model ResumoConversa {
  id              String     @id @default(cuid())
  empresaId       String
  conversaId      String
  tipo            TipoResumo
  texto           String
  geradoPorModelo String
  criadoEm        DateTime   @default(now())

  empresa  Empresa  @relation(fields: [empresaId], references: [id])
  conversa Conversa @relation(fields: [conversaId], references: [id])

  @@index([empresaId, conversaId, criadoEm])
}

/// 👍/👎 numa resposta da IA. Alimenta a medição de qualidade do agente
/// (Fase D) — sem isto, "o bot está ruim" continua sendo impressão.
model FeedbackIA {
  id         String         @id @default(cuid())
  empresaId  String
  mensagemId String
  util       Boolean
  comentario String?
  origem     OrigemFeedback
  criadoEm   DateTime       @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id])

  /// Um feedback por mensagem e origem — clicar duas vezes no 👍 não vira dois.
  @@unique([empresaId, mensagemId, origem])
}

enum TipoProposta {
  /// Os três primeiros são o fluxo de venda na conversa (doc 12 §6).
  montar_pedido
  gerar_cobranca
  enviar_contrato

  // Os tipos de agenda (criar/remarcar/cancelar agendamento) que o doc 02
  // previa NÃO entram aqui: o módulo está congelado (doc 12 §1.2) e não expõe
  // tools de IA. Valor de enum sem uso é dívida morta — eles voltam junto com o
  // módulo, se ele voltar.
}

enum StatusProposta {
  /// MAIÚSCULAS por herança do ev-tracker (doc 02 §7, exceção declarada):
  /// mantém o motor propose-confirm reusável sem renomear estados em código
  /// que já rodou em produção.
  PENDENTE
  CONFIRMADA
  EXPIRADA
  REJEITADA
}

enum TipoResumo {
  handoff
  encerramento
}

/// Um agente de IA do tenant. O "quem" do estado bot_ia da Conversa.
/// A configuração viva mora na VERSÃO — aqui fica só a identidade e qual
/// versão está no ar.
model AgenteIA {
  id            String    @id @default(cuid())
  empresaId     String
  nome          String
  ativo         Boolean   @default(true)
  /// FK lógica para VersaoAgente (evita ciclo de FK no Prisma).
  versaoAtivaId String?
  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @updatedAt
  deletedAt     DateTime?

  empresa Empresa        @relation(fields: [empresaId], references: [id])
  versoes VersaoAgente[]

  @@unique([empresaId, nome])
  @@index([empresaId, ativo])
}

/// PUBLICAR É CONGELAR (mesmo desenho de VersaoFluxo, doc 05 §3.1): conversa em
/// andamento termina na versão em que começou. Editar um agente enquanto ele
/// atende trocaria a persona no meio da frase.
model VersaoAgente {
  id               String             @id @default(cuid())
  empresaId        String
  agenteId         String
  numero           Int
  status           StatusVersaoAgente @default(rascunho)
  /// System prompt escrito pelo tenant. Entra no turno dentro de moldura
  /// anti-injection — ver MOLDURA_DE_DADOS_NO_SYSTEM em @atende/core.
  persona          String
  provedor         String             @default("anthropic")
  modelo           String?
  /// string[] validada contra o registry — nunca aceita cega.
  toolsHabilitadas Json               @default("[]")
  /// Janelas de atendimento por dia da semana, no fuso da Unidade.
  horarioAtuacao   Json?
  /// Gatilhos de palavra, limite de falhas, fila destino.
  handoffConfig    Json?
  criadoEm         DateTime           @default(now())
  publicadaEm      DateTime?

  empresa Empresa  @relation(fields: [empresaId], references: [id])
  agente  AgenteIA @relation(fields: [agenteId], references: [id])

  @@unique([empresaId, agenteId, numero])
  @@index([empresaId, agenteId, status])
}

enum StatusVersaoAgente {
  rascunho
  publicada
  arquivada
}

/// Credencial de sistema externo (ERP, CRM, gateway), por tenant.
/// As credenciais são cifradas AES-256-GCM (regra 15) e NUNCA saem em DTO.
model IntegracaoExterna {
  id                   String              @id @default(cuid())
  empresaId            String
  categoria            CategoriaIntegracao
  /// mensvra_erp | sankhya | omie | ploomes | asaas… — string livre porque o
  /// catálogo de drivers vive em @atende/integracoes e cresce sem migration.
  tipo                 String
  nome                 String
  credenciaisCifradas  String
  /// Segredo do HMAC do webhook do provedor. Dois ativos durante rotação.
  webhookSecretCifrado String?
  status               StatusIntegracao    @default(conectada)
  ultimoErro           String?
  ultimaSincronizacao  DateTime?
  criadoEm             DateTime            @default(now())
  atualizadoEm         DateTime            @updatedAt

  empresa     Empresa              @relation(fields: [empresaId], references: [id])
  mapeamentos MapeamentoEntidade[]

  /// Uma integração por categoria+tipo: dois ERPs "omie" no mesmo tenant não
  /// fazem sentido e tornariam ambíguo qual responde a uma tool.
  @@unique([empresaId, categoria, tipo])
}

enum CategoriaIntegracao {
  erp
  crm
  pagamento
  /// Provedor de modelo (anthropic, gemini…). A chave do tenant mora em
  /// `IntegracaoExterna.credenciaisCifradas` em vez de um model próprio: sem
  /// fallback para chave da plataforma, um `ConfigIAEmpresa` seria uma tabela
  /// com uma coluna útil — e aqui já vêm cifragem, status e `ultimoErro`.
  /// Divergência do doc 12 §5.6, registrada no doc 11.
  ia
}

enum StatusIntegracao {
  conectada
  erro
  pausada
}

/// Correlação id local ↔ id externo. É o que torna a sincronização IDEMPOTENTE:
/// sem isto, reenviar um pedido depois de um timeout cria o segundo no ERP.
model MapeamentoEntidade {
  id           String   @id @default(cuid())
  empresaId    String
  integracaoId String
  entidade     String // produto | cliente | pedido | cobranca | contrato
  idLocal      String
  idExterno    String
  criadoEm     DateTime @default(now())

  empresa    Empresa           @relation(fields: [empresaId], references: [id])
  integracao IntegracaoExterna @relation(fields: [integracaoId], references: [id])

  /// Únicos nos DOIS sentidos: um local aponta para um externo e vice-versa.
  @@unique([empresaId, integracaoId, entidade, idLocal])
  @@unique([empresaId, integracaoId, entidade, idExterno])
}

enum OrigemFeedback {
  cliente
  atendente
}

model Mensagem {
  id             String          @id @default(cuid())
  empresaId      String
  canalId        String
  conversaId     String
  direcao        DirecaoMensagem
  tipo           TipoMensagem    @default(texto)
  origemMotor    OrigemMensagem
  texto          String?
  midia          Json? // ponteiros R2 (Bloco 3 mídia chega depois)
  idExterno      String? // dedupe de webhook — unique composto abaixo
  respostaA      String? // idExterno citado (propose-confirm, Bloco 4)
  autorUsuarioId String? // quando origemMotor=humano
  statusEntrega  StatusEntrega   @default(pendente)
  // Instante do claim. É o que permite descobrir reserva órfã: `enviando` com
  // carimbo velho é worker que morreu no meio, e vira `falhou` visível em vez
  // de mensagem perdida em silêncio.
  envioReservadoEm DateTime?
  criadoEm       DateTime        @default(now())
  arquivadaEm    DateTime? // arquivamento >90d em R2 (doc 02 §14.2)
  ponteiroR2     String?
  deletedAt      DateTime?

  empresa  Empresa  @relation(fields: [empresaId], references: [id])
  canal    Canal    @relation(fields: [canalId], references: [id])
  conversa Conversa @relation(fields: [conversaId], references: [id])
  autor    Usuario? @relation(fields: [autorUsuarioId], references: [id])

  // Dedupe: provedores reentregam webhook; a 2ª entrega morre aqui.
  // idExterno NULL (mensagens internas) fica fora do unique (semântica
  // de NULL do Postgres — desejada, doc 02 §5).
  @@unique([empresaId, canalId, idExterno])
  // Rolagem do chat — consulta mais frequente do sistema. SEM empresaId de
  // propósito: conversaId (cuid) já isola; índice enxuto vale mais (exceção
  // deliberada à convenção de prefixo, doc 02 §14.1).
  @@index([conversaId, criadoEm])
}

// Sessão WhatsApp (Baileys) persistida — a máquina do worker é descartável;
// a credencial vive aqui, cifrada (doc 01: "worker é gado, não estimação").
model AuthStateBaileys {
  id           String @id @default(cuid())
  empresaId    String
  canalId      String
  chave        String // nome da credencial Baileys (creds, app-state-sync-key-*, ...)
  valorCifrado String // AES-256-GCM (regra 15)

  empresa Empresa @relation(fields: [empresaId], references: [id])
  canal   Canal   @relation(fields: [canalId], references: [id])

  @@unique([empresaId, canalId, chave])
}

// ─────────────────────────────────────────────────────────────
// Domínio LGPD (doc 02 §11) — trilha inviolável, devida desde o
// Bloco 0 (doc 04 §2.1). SEM @relation de propósito (regra
// inviolável 6): cascade delete não pode apagar trilha —
// usuarioId/clienteId/empresaId são Strings puras.
// ─────────────────────────────────────────────────────────────

enum TipoSolicitacaoLGPD {
  acesso
  correcao
  exclusao
  portabilidade
  revogacao_consentimento
}

enum StatusSolicitacaoLGPD {
  aberta
  em_andamento
  concluida
  recusada
}

model AuditLog {
  id          String   @id @default(cuid())
  empresaId   String
  usuarioId   String? // String pura — SEM relation (regra inviolável 6)
  acao        String
  entidade    String
  entidadeId  String?
  dadosAntes  Json?
  dadosDepois Json?
  ip          String?
  criadoEm    DateTime @default(now())

  @@index([empresaId, criadoEm]) // painel LGPD e cron de retenção (doc 02 §14.1)
}

model AccessLog {
  id        String   @id @default(cuid())
  empresaId String
  usuarioId String? // String pura — SEM relation
  rota      String
  metodo    String
  ip        String?
  userAgent String?
  criadoEm  DateTime @default(now())

  @@index([empresaId, criadoEm])
}

// INSERT-ONLY (regra inviolável 7): revogação é um NOVO registro com
// concedido=false — nunca update/upsert.
model ConsentimentoLGPD {
  id          String   @id @default(cuid())
  empresaId   String
  clienteId   String? // String pura — SEM relation
  tipo        String // finalidade do tratamento
  concedido   Boolean
  textoVersao String
  origem      String // conversa | booking | painel
  criadoEm    DateTime @default(now())

  @@index([empresaId, clienteId])
}

model SolicitacaoLGPD {
  id          String                @id @default(cuid())
  empresaId   String
  clienteId   String? // String pura — SEM relation
  tipo        TipoSolicitacaoLGPD
  status      StatusSolicitacaoLGPD @default(aberta)
  protocolo   String
  abertaEm    DateTime              @default(now())
  concluidaEm DateTime?
  respostaR2  String? // ponteiro do export gerado (R2)

  @@unique([empresaId, protocolo])
}

model ConfigLgpd {
  id                    String  @id @default(cuid())
  empresaId             String  @unique // 1 por empresa (doc 02 §11)
  // Defaults de partida — o tenant ajusta no painel LGPD (Bloco 6)
  retencaoMensagensDias Int     @default(365)
  retencaoLogsDias      Int     @default(365)
  textoConsentimento    String?
  dpoNome               String?
  dpoEmail              String?
}

// ─────────────────────────────────────────────────────────────
// ATENDIMENTO — a operação que o comprador exige (E1 do plano)
//
// Até aqui "fila" era um valor de estado (`fila_humano`): a conversa esperava
// alguém, e não havia quem, nem prazo, nem escalonamento. Para o gerente
// comercial de uma distribuidora, isso é o produto inteiro — é onde ele enxerga
// produtividade pela primeira vez.
// ─────────────────────────────────────────────────────────────

/// Como a fila escolhe o atendente de uma conversa nova.
enum DistribuicaoFila {
  /// Rodízio simples entre os membros ativos.
  rodizio
  /// Quem tem menos conversa aberta recebe.
  carga
  /// Vai para o vendedor responsável pelo cliente; sem carteira, cai no rodízio.
  carteira
  /// Ninguém recebe automaticamente — a fila fica visível e alguém assume.
  manual
}

model Fila {
  id        String  @id @default(cuid())
  empresaId String
  nome      String
  descricao String?

  /// Prazo de primeira resposta, em minutos. É o número que o painel cobra e o
  /// que dispara alerta ANTES do estouro — não depois, que é quando o cliente
  /// já desistiu.
  prazoPrimeiraRespostaMin Int?
  /// Prazo de resolução, em minutos.
  prazoResolucaoMin        Int?

  distribuicao DistribuicaoFila @default(manual)

  /// Expediente da fila: `{ dias: { seg: [["08:00","18:00"]] }, fuso }`.
  /// Json e não colunas porque a forma varia (turno partido, sábado meio
  /// período) e nenhuma consulta filtra por isso — quem lê é o roteador.
  horarioJson         Json?
  mensagemForaHorario String?

  ativa    Boolean  @default(true)
  ordem    Int      @default(0)
  criadoEm DateTime @default(now())

  empresa   Empresa          @relation(fields: [empresaId], references: [id])
  membros   MembroFila[]
  conversas Conversa[]
  respostas RespostaRapida[]

  @@unique([empresaId, nome])
  @@index([empresaId, ativa, ordem])
}

/// Quem pode receber conversa desta fila.
model MembroFila {
  id        String  @id @default(cuid())
  empresaId String
  filaId    String
  usuarioId String
  ativo     Boolean @default(true)

  fila    Fila    @relation(fields: [filaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([filaId, usuarioId])
  @@index([empresaId, usuarioId])
}

/// Motivo de encerramento — taxonomia do tenant, obrigatória no fechamento.
/// É o que transforma a inbox em relatório de demanda: sem motivo, no mês
/// seguinte ninguém sabe por que as conversas terminaram.
model MotivoEncerramento {
  id        String  @id @default(cuid())
  empresaId String
  nome      String
  ativo     Boolean @default(true)
  ordem     Int     @default(0)

  empresa   Empresa    @relation(fields: [empresaId], references: [id])
  conversas Conversa[]

  @@unique([empresaId, nome])
  @@index([empresaId, ativo])
}

/// Etiqueta de conversa — corte livre do tenant, para filtro e relatório.
model EtiquetaConversa {
  id        String  @id @default(cuid())
  empresaId String
  nome      String
  cor       String? // token de cor da interface, não hex cru
  ativa     Boolean @default(true)

  empresa   Empresa            @relation(fields: [empresaId], references: [id])
  conversas ConversaEtiqueta[]

  @@unique([empresaId, nome])
}

model ConversaEtiqueta {
  id         String   @id @default(cuid())
  empresaId  String
  conversaId String
  etiquetaId String
  criadoEm   DateTime @default(now())

  conversa Conversa         @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  etiqueta EtiquetaConversa @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)

  @@unique([conversaId, etiquetaId])
  @@index([empresaId, etiquetaId])
}

/// Resposta pronta, chamada por atalho no composer.
model RespostaRapida {
  id        String  @id @default(cuid())
  empresaId String
  atalho    String // sem a barra: "prazo" vira "/prazo" na digitação
  titulo    String
  texto     String
  /// Restrita a uma fila, ou de toda a empresa quando nulo.
  filaId    String?
  ativa     Boolean @default(true)

  empresa Empresa @relation(fields: [empresaId], references: [id])
  fila    Fila?   @relation(fields: [filaId], references: [id], onDelete: SetNull)

  @@unique([empresaId, atalho])
  @@index([empresaId, ativa])
}

/// Nota interna da conversa — visível só para a equipe, nunca para o cliente.
/// Separada de `NotaCliente`: aquela é sobre a pessoa e vive para sempre; esta
/// é sobre o atendimento, e é onde o atendente escreve o que não pode ser dito.
model NotaConversa {
  id             String   @id @default(cuid())
  empresaId      String
  conversaId     String
  autorUsuarioId String
  texto          String
  criadoEm       DateTime @default(now())

  conversa Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  autor    Usuario  @relation("NotasDeConversa", fields: [autorUsuarioId], references: [id])

  @@index([empresaId, conversaId, criadoEm])
}

// ─────────────────────────────────────────────────────────────
// PLATAFORMA — o billing do NOSSO SaaS (doc 02 §10)
//
// Exceção às convenções de tenancy: `PlanoLicenca` é catálogo global; os demais
// referenciam `empresaId` como DADO e são operados por jobs de plataforma
// auditados, porque aqui o operador é a plataforma e não o tenant.
//
// Sem estes models não existe cobrança — e sem cobrança o produto não é
// vendável, por mais funcionalidade que tenha.
// ─────────────────────────────────────────────────────────────

enum StatusAssinaturaPlataforma {
  trial
  ativa
  inadimplente
  cancelada
}

model PlanoLicenca {
  id                   String  @id @default(cuid())
  chave                String  @unique // catálogo global — exceção prevista (doc 02 §2)
  nome                 String
  precoMensalCentavos  Int
  limiteUsuarios       Int
  limiteCanais         Int
  limiteConversasIaMes Int
  /// Excedente por conversa de IA acima do limite, em centavos.
  excedenteIaCentavos  Int     @default(49)
  permiteApi           Boolean @default(false)
  apiRateLimitRpm      Int     @default(60)
  ordem                Int     @default(0)
  ativo                Boolean @default(true)

  assinaturas AssinaturaPlataforma[]
}

model AssinaturaPlataforma {
  id                String                     @id @default(cuid())
  empresaId         String
  planoId           String
  status            StatusAssinaturaPlataforma @default(trial)
  trialAte          DateTime?
  iniciadaEm        DateTime                   @default(now())
  canceladaEm       DateTime?
  /// Id da cobrança no provedor de pagamento, quando houver.
  idExternoCobranca String?

  empresa Empresa      @relation(fields: [empresaId], references: [id])
  plano   PlanoLicenca @relation(fields: [planoId], references: [id])

  @@index([empresaId, status])
}

/// Consumo medido por mês. É a fonte da fatura.
///
/// O painel exige teto de custo de IA por plano com degradação — e teto sem
/// medição é promessa. Os contadores sobem no fechamento do turno, nunca por
/// gatilho de banco: assim o número que cobra é o mesmo que o produto viu.
model UsoMensal {
  id              String   @id @default(cuid())
  empresaId       String
  mesReferencia   String // "2026-08"
  conversasIa     Int      @default(0)
  mensagens       Int      @default(0)
  tokensEntrada   Int      @default(0)
  tokensSaida     Int      @default(0)
  custoIaCentavos Int      @default(0)
  atualizadoEm    DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, mesReferencia])
}

/// Uma execução de modelo, para auditar a fatura linha a linha.
model UsoIA {
  id                    String   @id @default(cuid())
  empresaId             String
  conversaId            String?
  agenteVersaoId        String?
  provedor              String
  modelo                String
  tokensEntrada         Int
  tokensSaida           Int
  custoEstimadoCentavos Int      @default(0)
  criadoEm              DateTime @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@index([empresaId, criadoEm])
}

/// Aceite do DPA — insert-only, como consentimento LGPD.
/// `aceitoPorUsuarioId` é String pura, sem relation: trilha jurídica não pode
/// sumir em cascade (mesma regra dos models LGPD).
model DpaAceite {
  id                 String   @id @default(cuid())
  empresaId          String
  versaoDpa          String
  aceitoPorUsuarioId String
  ipAceite           String?
  aceitoEm           DateTime @default(now())

  @@index([empresaId, aceitoEm])
}
